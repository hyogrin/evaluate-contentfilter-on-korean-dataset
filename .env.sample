# this is a sample for keys used in this code repo. 
# Please rename it to .env before you can use it

# Azure Open AI - See https://learn.microsoft.com/en-us/azure/ai-services/openai/api-version-deprecation

AZURE_OPENAI_ENDPOINT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AZURE_OPENAI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AZURE_OPENAI_DEPLOYMENT_NAME=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AZURE_OPENAI_API_VERSION=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  # "2023-09-01-preview"
OPENAI_MODEL_VERSION=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FILTER_NAME=defaultv2
BLOCKING_THRESHOLD_LEVEL=middle

# Azure Content Safety (for content_safety evaluation target)
CONTENT_SAFETY_ENDPOINT=https://your-content-safety-resource.cognitiveservices.azure.com/
CONTENT_SAFETY_KEY=your-content-safety-key-here
# Content Safety Threshold (0-6, higher means stricter)
# 1: low
# 4: medium
# 6: high
CONTENT_SAFETY_THRESHOLD=4
